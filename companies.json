    {
      "name": "Marqeta",
      "careers_url": "https://www.marqeta.com/company/careers",
      "adapter": "custom_html",
      "_note": "The Greenhouse token now 404s; Marqeta serves its own list, server-rendered, whole board on one page. Each row is an <a> wrapping three cells: title, department, location. The description page has no dedicated container, so the detail selector grabs the page shell - nav and footer text comes along with it. Tailwind utility classes are the only hooks here, so a redesign will break these selectors.",
      "params": {
        "url": "https://www.marqeta.com/company/careers",
        "item_selector": "a[href^='/careers/']",
        "base_url": "https://www.marqeta.com",
        "fields": {
          "title": { "selector": "td:nth-of-type(1)" },
          "department": { "selector": "td:nth-of-type(2)" },
          "location": { "selector": "td:nth-of-type(3)" },
          "job_url": { "selector": ".", "attr": "href" }
        },
        "detail": { "description_selector": "div.min-h-screen" }
      },
      "_verified": "40 jobs",
      "enabled": true
    },

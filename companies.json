    {
      "name": "Atlassian",
      "careers_url": "https://www.atlassian.com/company/careers/all-jobs",
      "adapter": "custom_json",
      "_note": "Atlassian runs its own listings endpoint in front of iCIMS. Description is split across overview/responsibilities/qualifications, mapped as sections so 'Qualifications' feeds the required-skills bucket.",
      "params": {
        "url": "https://www.atlassian.com/endpoint/careers/listings",
        "fields": {
          "title": "title",
          "location": "locations",
          "department": "category",
          "external_id": "id",
          "job_url": "portalJobPost.portalUrl",
          "apply_url": "applyUrl",
          "posted_date": "portalJobPost.updatedDate"
        },
        "sections": {
          "Overview": "overview",
          "Responsibilities": "responsibilities",
          "Qualifications": "qualifications"
        }
      },
      "_verified": "236 jobs",
      "enabled": true
    },

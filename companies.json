    {
      "name": "Amazon",
      "careers_url": "https://www.amazon.jobs/en/search",
      "adapter": "custom_json",
      "_note": "amazon.jobs exposes search.json. Filtering is by exact normalized_location strings - add cities to that list as needed. basic_qualifications/preferred_qualifications map cleanly onto the required/preferred skill buckets.",
      "params": {
        "url": "https://www.amazon.jobs/en/search.json",
        "base_url": "https://www.amazon.jobs",
        "query": {
          "normalized_location[]": [
            "Bengaluru, Karnataka, IND",
            "Hyderabad, Telangana, IND",
            "Chennai, Tamil Nadu, IND"
          ],
          "sort": "recent"
        },
        "list_path": "jobs",
        "fields": {
          "title": "title",
          "location": "normalized_location",
          "department": "job_category",
          "employment_type": "job_schedule_type",
          "external_id": "id_icims",
          "job_url": "job_path",
          "posted_date": "posted_date"
        },
        "sections": {
          "Description": "description",
          "Basic Qualifications": "basic_qualifications",
          "Preferred Qualifications": "preferred_qualifications"
        },
        "pagination": {
          "kind": "offset",
          "param": "offset",
          "size_param": "result_limit",
          "size": 100,
          "total_path": "hits",
          "max_pages": 5
        }
      },
      "_verified": "205 jobs for Bengaluru alone",
      "enabled": true
    },
